{
  // AEM X-Series wideband via an OBDX Pro over WiFi.
  // DeviceKey = tcp:<obdx-ip>:<port>.  OBDX SoftAP default is tcp:192.168.4.1:23
  // (join the OBDX's own WiFi network). If the OBDX is joined to your LAN (station mode),
  // use its LAN IP instead, e.g. "tcp:192.168.1.50:35000".
  "Adapter": "Obdx",
  "DeviceKey": "tcp:192.168.4.1:23",
  "BitRate": "Br500kBit",
  "DbcPath": "DBC\\AEM_X-Series.dbc",
  "ServerAddress": "",
  "Routes": [
    { "Signal": "Lambda", "ChannelNo": 10, "Scale": 0.001, "Offset": 0.0 }
  ]
}
